# Portable example. In a container, bind-mount RAW_SCAN as a writable volume
# on one filesystem. The listener writes hidden .name.png.part files and only
# atomically publishes completed scans as .png after fsync. Leave
# ES60W_LOG_FILE empty so logs go only to stdout.
RAW_SCAN=/data/raw
ES60W_SCANNER_IP=192.168.6.134
ES60W_SCANNER_PORT=1865
ES60W_LOCAL_IP=0.0.0.0
ES60W_EVENT_GROUP=239.255.255.253
ES60W_EVENT_PORT=2968
ES60W_SANE_DEVICE=epsonds:net:192.168.6.134
ES60W_SCANIMAGE_BINARY=/usr/bin/scanimage
ES60W_OUTPUT_FORMAT=png
ES60W_SCAN_SOURCE=ADF Front
ES60W_SCAN_MODE=Color
ES60W_RESOLUTION=300
ES60W_PAGE_WIDTH_MM=215.9
ES60W_PAGE_HEIGHT_MM=355.6
ES60W_LOG_LEVEL=INFO
ES60W_LOG_FILE=

# The proven defaults below normally do not need adjustment.
ES60W_TRANSACTION_RETENTION_SECONDS=120
ES60W_REACHABILITY_INTERVAL_SECONDS=2
ES60W_SCAN_START_DELAY_SECONDS=0.75
ES60W_MAX_ZERO_BYTE_ATTEMPTS=3
ES60W_ZERO_BYTE_RETRY_DELAY_SECONDS=1
ES60W_POST_SCAN_SUPPRESSION_SECONDS=3
ES60W_SCAN_TIMEOUT_SECONDS=120
